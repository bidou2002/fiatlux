  },
  "grids": {
    "pupil": {
      "nx": 64,
      "ny": 64,
      "dx": 0.015625,
      "dy": 0.015625
    },
    "focal": {
      "nx": 80,
      "ny": 80,
      "dx": 4.125e-06,
      "dy": 4.125e-06
    }
  },
  "format": "fiatlux-canvas",
  "version": 2,
  "nodes": [
    {
      "id": "source",
      "type": "PlaneWave",
      "params": {
        "grid": "pupil"
      }
    },
    {
      "id": "pupil",
      "type": "CircularAperture",
      "params": {
        "grid": "pupil",
        "radius": 0.5
      }
    },
    {
      "id": "atmosphere",
      "type": "Kolmogorov",
      "params": {
        "grid": "pupil",
        "r0": 0.2,
        "reference_wavelength": 5e-07,
        "outer_scale": null,
        "seed": 42,
        "realization": 0
      }
    },
    {
      "id": "dm",
      "type": "DeformableMirror",
      "params": {
        "grid": "pupil",
        "commands": [
          3e-08,
          -1.5e-08,
          6e-08
        ],
        "stroke": 1e-06
      }
    },
    {
      "id": "focus",
      "type": "MFTPropagator",
      "params": {
        "output_grid": "focal",
        "propagation": "fraunhofer",
        "focal_length": 10.0,
        "distance": null
      }
    },
    {
      "id": "detector",
      "type": "Detector",
      "params": {
        "grid": "focal",
        "exposure_time": 0.15,
        "quantum_efficiency": 1.0,
        "photon_noise": false,
        "dark_current": 0.0,
        "readout_noise_variance": 0.0,
        "digitize": false,
        "sensitivity": 1.0,
        "offset": 0,
        "bitdepth": 16,
        "random_seed": 42
      }
    },
    {
      "id": "view-phase",
      "type": "Visualization",
      "params": {
        "quantity": "phase",
        "channel": "0",
        "colormap": "diverging",
        "scale": "linear",
        "minimum": null,
        "maximum": null,
        "opd_unit": "nm",
        "latent": {}
      }
    },
    {
      "id": "view-opd",
      "type": "Visualization",
      "params": {
        "quantity": "opd",
        "channel": "sum",
        "colormap": "diverging",
        "scale": "linear",
        "minimum": null,
        "maximum": null,
        "opd_unit": "nm",
        "latent": {}
      }
    },
    {
      "id": "view-intensity",
