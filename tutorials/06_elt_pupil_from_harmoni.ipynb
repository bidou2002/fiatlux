          ]
        }
      ],
      "source": [
        "pupil_mask = atm_res.pupil.to(torch.float32)\n",
        "\n",
        "print(\"Pupil mask shape:\", pupil_mask.shape)\n",
        "print(\"Unique values:\", torch.unique(pupil_mask))"
